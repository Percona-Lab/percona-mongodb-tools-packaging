# Go dependency overrides applied to mongo-tools by scripts/mongo_tools_builder.sh
# (--get_sources), between `git clone` and `go mod tidy && go mod vendor`.
#
# These bump dependencies above what upstream mongo-tools pins, to clear CVEs. Editing
# this file plus bumping --release is the whole point of this repo: it makes a tools-only
# security rebuild a minutes-long job instead of a full PSMDB rebuild.
#
# Kept in step with percona-server-mongodb/percona-packaging/scripts/psmdb_builder.sh.
# Current values are PSMDB-2259 ("Update go and libs to fix CVEs"), as shipped in
# release-7.0.43-23 and present on v7.0 / v8.0 / v8.3.
#
# Against mongo-tools 100.18.0 all four are genuine upgrades -- upstream pins
# crypto v0.54.0, net v0.56.0, text v0.40.0, compress v1.18.6.
#
# DROP_REPLACE: modules whose upstream `replace` directive must be removed first.
#   NB: mongo-tools 100.18.0 has NO replace directives, so this is currently a no-op.
#   It is kept verbatim from psmdb_builder.sh so the two stay comparable. Re-check with
#   `grep replace go.mod` after every MONGO_TOOLS_TAG_VERSION bump.
# GET: the versions we actually want. `go get` will happily DOWNGRADE if these fall
#   behind what upstream pins, so re-derive them on every tag bump.

GO_DEPS_DROP_REPLACE="golang.org/x/crypto@v0.45.0 golang.org/x/net@v0.47.0 golang.org/x/text@v0.31.0 github.com/klauspost/compress@v1.17.8"

GO_DEPS_GET="golang.org/x/crypto@v0.56.0 golang.org/x/net@v0.57.0 golang.org/x/text@v0.41.0 github.com/klauspost/compress@v1.18.7"
