# Go dependency overrides for mongo-tools, applied by mongo_tools_builder.sh --get_sources.
# To fix a CVE: raise the version here and bump --release.
#
# GET: minimum versions; a module is only bumped if upstream pins it lower (log: keep/bump)
# DROP_REPLACE: upstream replace directives to drop first, kept as in psmdb_builder.sh
#
# values from PSMDB-2259

GO_DEPS_DROP_REPLACE="golang.org/x/crypto@v0.45.0 golang.org/x/net@v0.47.0 golang.org/x/text@v0.31.0 github.com/klauspost/compress@v1.17.8"

GO_DEPS_GET="golang.org/x/crypto@v0.56.0 golang.org/x/net@v0.57.0 golang.org/x/text@v0.41.0 github.com/klauspost/compress@v1.18.7"
