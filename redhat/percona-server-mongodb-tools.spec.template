# Standalone spec for the MongoDB Database Tools as packaged by Percona.
#
# Lifted from percona-server-mongodb/percona-packaging/redhat/percona-server-mongodb.spec.template
# (v8.3): the `%package tools` stanza, its Conflicts, the "Mongo Tools compilation" block and
# the `%files tools` list are reproduced as they are there, so this package is a drop-in
# replacement for the subpackage it takes over from.
#
# Placeholders are filled in by scripts/mongo_tools_builder.sh, same convention as PSMDB:
#   @@VERSION@@  @@RELEASE@@  @@SOURCE_TARBALL@@  @@SRC_DIR@@

# Debuginfo handling, carried over verbatim from the PSMDB spec template (lines 1-22).
# PSMDB publishes a separate percona-server-mongodb-tools-debuginfo package (verified
# against 8.3.8-2: 29 MB, Group Development/Debug, 36 files under /usr/lib/debug, provides
# debuginfo(build-id) for all 8 binaries, and NO accompanying -debugsource package), so
# this spec must keep producing it. rpm derives it automatically from the package name.
%global __brp_strip_args --strip-debug
%global __find_debuginfo /usr/lib/rpm/find-debuginfo.sh -g

# Disable the addition of mini debuginfo and gdb index options
%global _include_minidebuginfo %{nil}
%undefine _include_gdb_index

# Optionally disable source extraction to avoid empty debugsourcefiles.list errors
%global __find_debugsource %{nil}

%if  0%{?amzn} == 2023 || 0%{?rhel} >= 8
%undefine _debugsource_packages
%endif

%if  0%{?amzn} == 2023 || 0%{?rhel} >= 8
%global _find_debuginfo_dwz_opts %{nil}
%endif

# NB: the /usr/lib/.build-id/* symlink tree stays in the main package -- the published
# 8.3.8-2 RPM ships it too, so `_build_id_links none` would make our file list differ.

Name:           percona-server-mongodb-tools
Version:        @@VERSION@@
Release:        @@RELEASE@@%{?dist}
Summary:        The tools package for Percona Server for MongoDB
Group:          Applications/Databases

# The tools are Apache-2.0 upstream, unlike the SSPL-licensed PSMDB server.
License:        ASL 2.0
# Kept pointing at PSMDB, exactly as the published package does. This is the product URL
# users should land on, not the upstream repo we happen to build from.
URL:            https://github.com/percona/percona-server-mongodb.git
Source0:        @@SOURCE_TARBALL@@

BuildRoot:      /var/tmp/%{name}-%{version}-%{release}
%undefine       _missing_build_ids_terminate_build
%define         _unpackaged_files_terminate_build 0

%define         src_dir @@SRC_DIR@@

# gssapi is one of the build tags, and it is cgo: -lgssapi_krb5 -lkrb5
BuildRequires: gcc, krb5-devel

Conflicts: Percona-Server-MongoDB-tools Percona-Server-MongoDB-32-tools Percona-Server-MongoDB-34-tools Percona-Server-MongoDB-36-tools mongodb-org-tools mongodb-database-tools

%description
This package contains various tools from MongoDB project, recompiled for Percona Server for MongoDB

%prep
%setup -q -n %{src_dir}

%build
mkdir -p $RPM_BUILD_DIR/%{src_dir}/bin
pushd $RPM_BUILD_DIR/
[[ ${PATH} == *"/usr/local/go/bin"* && -x /usr/local/go/bin/go ]] || export PATH=/usr/local/go/bin:${PATH}
export GOROOT="/usr/local/go/"
export GOPATH=$(pwd)/
export PATH="/usr/local/go/bin:$PATH:$GOPATH"
export GOBINPATH="/usr/local/go/bin"
mkdir -p $GOPATH/src/github.com/mongodb
cp -r $RPM_BUILD_DIR/%{src_dir} ${GOPATH}/src/github.com/mongodb/mongo-tools
pushd ${GOPATH}/src/github.com/mongodb/mongo-tools
. ./set_tools_revision.sh
# Version/commit stamping. `sed '14d'` drops the goke/pkg/git import and shifts every later
# line by one, which is why the next sed's 246,254 lands on the original 247-255 (the
# versionStr and gitCommit blocks). Tied to the upstream tag -- re-verify on every bump of
# MONGO_TOOLS_TAG_VERSION.
sed -i '14d' buildscript/build.go
sed -i '246,254d' buildscript/build.go
sed -i "s:versionStr,:\"$PSMDB_TOOLS_REVISION\",:" buildscript/build.go
sed -i "s:gitCommit):\"$PSMDB_TOOLS_COMMIT_HASH\"):" buildscript/build.go
./make build
mv bin/* $RPM_BUILD_DIR/%{src_dir}/bin
popd
popd

# Both stamping and build-tag selection fail *silently* upstream (getBuildFlags only logs),
# so assert instead of trusting the build.
pushd $RPM_BUILD_DIR/%{src_dir}
./bin/mongodump --version | grep -q "^mongodump version: ${PSMDB_TOOLS_REVISION}$" \
    || { echo "ERROR: version stamping failed"; ./bin/mongodump --version; exit 1; }
ldd bin/mongodump | grep -q libgssapi_krb5 \
    || { echo "ERROR: built without the gssapi build tag"; ldd bin/mongodump; exit 1; }
popd

%install
rm -rf %{buildroot}
install -m 755 -d %{buildroot}/%{_bindir}
install -m 755 -d %{buildroot}/%{_mandir}/man1

install -m 755 $RPM_BUILD_DIR/%{src_dir}/bin/* %{buildroot}/%{_bindir}/
install -m 644 $RPM_BUILD_DIR/%{src_dir}/manpages/* %{buildroot}/%{_mandir}/man1/

%clean
rm -rf %{buildroot}

%files
%defattr(-,root,root,-)
%{_bindir}/bsondump
%{_mandir}/man1/bsondump.1.gz
%{_bindir}/mongostat
%{_mandir}/man1/mongostat.1.gz
%{_bindir}/mongofiles
%{_mandir}/man1/mongofiles.1.gz
%{_bindir}/mongoexport
%{_mandir}/man1/mongoexport.1.gz
%{_bindir}/mongoimport
%{_mandir}/man1/mongoimport.1.gz
%{_bindir}/mongorestore
%{_mandir}/man1/mongorestore.1.gz
%{_bindir}/mongodump
%{_mandir}/man1/mongodump.1.gz
%{_bindir}/mongotop
%{_mandir}/man1/mongotop.1.gz

%changelog
* Tue Sep 01 2026 Oleksandr Miroshnychenko <alex.miroshnychenko@percona.com>
- PSMDB-1944: split out of the percona-server-mongodb spec into its own package
